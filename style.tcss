.h-full {
  height: 1fr;
}

.h-auto {
  height: auto;
}

.w-full {
  width: 1fr;
}

.w-auto {
  width: auto;
}

.mr-1 {
  margin-right: 1;
}

.mr-2 {
  margin-right: 2;
}

.ml-1 {
  margin-left: 1;
}

.ml-2 {
  margin-left: 2;
}

.mx-1 {
  margin: 0 1;
}

.with-border {
  border: round $foreground 50%;
}

.text-center {
  text-align: center;
}


.sparkline--max-color {
  color: $success;
}
.sparkline--min-color {
  color: $error 50%;
}


.value.up {
  color: $success;
}
.value.down {
  color: $error;
}


.color-ascii {
  color: $foreground 50%;
}


#home #right ListView {
  background: transparent;
}

#home #right ListView > ListItem {
  padding: 1 2;
  height: 4;
  width: 1fr;
}

#home #right ListView > ListItem.-highlight {
  text-style: bold;
  color: $foreground;
  background: $panel;
}

Button {
  color: $foreground;
}

SelectionList {
  margin: 0 1;
  padding: 1 2;
  background: transparent;
}

#orders {
  align: center top;
}

#orders-datatable {
  width: auto
}